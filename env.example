# -----------------------------------------------------------------------------
# Environment variables for Blackcat.petsitter
#
# Copy this file to `.env` (or `.env.local`) and fill in real values:
#     cp env.example .env
#
# All values below are intentionally blank. Never commit real secrets.
# -----------------------------------------------------------------------------

# PostgreSQL connection string (Neon pooled connection string).
# Used by Drizzle ORM (db/client.ts), drizzle-kit (drizzle.config.ts),
# the seed script, and the tenant tests.
DATABASE_URL=

# NextAuth v5 (Auth.js) — Google OAuth (already wired in the app).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth canonical URL (used in production).
AUTH_URL=
